---
import { education } from '../data/education';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id={t('anchor.education')} kicker={t('education.kicker')} title={t('education.title')}>
  <ol class="ml-1 border-l border-line pl-7">
    {education.map((item) => (
      <li class="relative pb-10 last:pb-0">
        <span
          class="absolute top-1.5 -left-[33px] size-2.5 rounded-full bg-accent"
          aria-hidden="true"
        />
        <p class="font-mono text-xs tracking-wide text-muted uppercase">
          {item.year} · {item.place[lang]}
        </p>
        <h3 class="mt-1.5 text-lg font-semibold">{item.degree[lang]}</h3>
        <p class="text-muted">{item.institution}</p>
      </li>
    ))}
  </ol>
</Section>
