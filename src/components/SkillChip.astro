---
import type { Tech } from '../data/skills';
import type { Lang } from '../i18n/ui';

interface Props {
  tech: Tech;
  lang: Lang;
}

const { tech, lang } = Astro.props;
const name = typeof tech.name === 'string' ? tech.name : tech.name[lang];
const brand = tech.icon ? (tech.brandLight ?? `#${tech.icon.hex}`) : undefined;
const brandDark = tech.icon ? (tech.brandDark ?? brand) : undefined;
---

<li
  class:list={[
    'chip inline-flex items-center gap-2 rounded-lg border border-line bg-surface py-2 pr-3.5 text-sm font-medium transition hover:-translate-y-px hover:border-accent',
    tech.icon ? 'pl-2.5' : 'pl-3.5',
  ]}
  style={brand ? `--brand: ${brand}; --brand-dark: ${brandDark}` : undefined}
>
  {tech.icon && (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      class="chip-icon size-[18px] fill-current text-muted transition-colors"
    >
      <path d={tech.icon.path} />
    </svg>
  )}
  {name}
</li>

<style>
  .chip:hover .chip-icon {
    color: var(--brand);
  }

  :global(.dark) .chip:hover .chip-icon {
    color: var(--brand-dark);
  }
</style>
