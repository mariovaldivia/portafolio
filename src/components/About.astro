---
import { aboutPillars, type PillarIcon } from '../data/about';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Íconos lineales (24×24, trazo), coloreados con currentColor.
const iconPaths: Record<PillarIcon, string[]> = {
  flow: ['M3 12h4l3-8 4 16 3-8h4'],
  cloud: ['M17.5 19a4.5 4.5 0 1 0-1.4-8.8A6 6 0 0 0 4.5 12 3.5 3.5 0 0 0 6 19z'],
  chip: [
    'M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z',
    'M9 9h6v6H9z',
    'M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3',
  ],
  check: ['M9 11l3 3L22 4', 'M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11'],
};
---

<Section id={t('anchor.about')} kicker={t('about.kicker')}>
  <div class="mt-5 grid gap-10 md:grid-cols-[1.15fr_1fr] md:items-center md:gap-12">
    <p class="text-lg leading-relaxed">{profile.bio[lang]}</p>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      {aboutPillars.map((pillar) => (
        <li class="rounded-lg border border-line bg-surface p-4 transition-colors hover:border-accent">
          <span class="grid size-8 place-items-center rounded-md border border-line bg-bg text-accent">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="size-[18px] fill-none stroke-current"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              {iconPaths[pillar.icon].map((d) => (
                <path d={d} />
              ))}
            </svg>
          </span>
          <h3 class="mt-3 text-sm font-semibold">{pillar.title[lang]}</h3>
          <p class="mt-1 text-[0.8rem] leading-snug text-muted">{pillar.text[lang]}</p>
        </li>
      ))}
    </ul>
  </div>
</Section>
