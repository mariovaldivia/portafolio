---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';
import { splitProjectId } from '../lib/project-utils';
import type { ProjectEntry } from '../lib/projects';
import TagList from './TagList.astro';

interface Props {
  entry: ProjectEntry;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { slug } = splitProjectId(entry.id);
const { title, summary, stack, year, company, cover, coverAlt } = entry.data;
const meta = [company, year].filter(Boolean).join(' · ');
---

<a
  href={localizePath(lang, `proyectos/${slug}`)}
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-line bg-surface transition hover:-translate-y-0.5 hover:border-accent"
>
  {cover && (
    <div class="aspect-[16/10] overflow-hidden border-b border-line">
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        widths={[400, 640, 960]}
        sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
        class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      />
    </div>
  )}
  <div class="flex flex-1 flex-col gap-3 p-6">
    {meta && <span class="font-mono text-xs text-muted">{meta}</span>}
    <h3 class="font-serif text-2xl leading-tight">{title}</h3>
    <p class="flex-1 text-sm text-muted">{summary}</p>
    <TagList items={stack} />
    <span class="mt-1 text-sm font-medium text-accent">
      {t('projects.more')}
      <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
    </span>
  </div>
</a>
