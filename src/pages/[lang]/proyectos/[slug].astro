---
import type { InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import TagList from '../../../components/TagList.astro';
import { profile } from '../../../data/profile';
import { localizePath, useTranslations } from '../../../i18n/utils';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { splitProjectId } from '../../../lib/project-utils';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => {
    const { lang, slug } = splitProjectId(entry.id);
    return { params: { lang, slug }, props: { entry, lang } };
  });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const { title, summary, stack, year, repo, demo, cover } = entry.data;
const externalLinks = [
  { href: repo, label: t('projects.repo') },
  { href: demo, label: t('projects.demo') },
].filter((link): link is { href: string; label: string } => Boolean(link.href));
---

<BaseLayout lang={lang} title={`${title} — ${profile.name}`} description={summary}>
  <article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <a
      href={`${localizePath(lang)}#${t('anchor.projects')}`}
      class="font-mono text-sm text-muted transition-colors hover:text-accent"
    >
      ← {t('projects.back')}
    </a>

    <header class="mt-10 border-b border-line pb-10">
      <p class="font-mono text-xs text-muted">{year}</p>
      <h1 class="mt-2 font-serif text-5xl leading-none md:text-6xl">{title}</h1>
      <p class="mt-5 text-lg text-muted">{summary}</p>
      <TagList items={stack} class="mt-6" />
      {externalLinks.length > 0 && (
        <div class="mt-6 flex gap-5 text-sm font-medium">
          {externalLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              class="text-accent underline-offset-4 hover:underline"
            >
              {link.label} ↗
            </a>
          ))}
        </div>
      )}
    </header>

    {cover && <Image src={cover} alt="" class="mt-10 rounded-xl border border-line" />}

    <div class="prose-tokens prose mt-10 max-w-none prose-headings:font-serif prose-headings:font-normal prose-h2:text-3xl">
      <Content />
    </div>
  </article>
</BaseLayout>
